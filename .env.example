# Backend — SQLite for zero-setup local; switch to Postgres when Docker is up
DATABASE_URL=sqlite:///./aifpl.db
# DATABASE_URL=postgresql+psycopg://aifpl:aifpl@localhost:5432/aifpl
REDIS_URL=redis://localhost:6379/0
FPL_API_BASE=https://fantasy.premierleague.com/api
CORS_ORIGINS=http://localhost:3000

# Vercel Services — backend mounted at /api/backend (set on Vercel env)
# SERVICE_PATH_PREFIX=/api/backend
# NEXT_PUBLIC_API_URL=/api/backend

# Vision scan (Gemini preferred; OpenAI optional fallback)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Frontend — leave unset on Vercel (auto uses /api/backend); local dev only:
NEXT_PUBLIC_API_URL=http://localhost:8000
